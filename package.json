{
	"name": "bun-playground",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --hot dev.ts",
		"dev:vanilla": "bun src/index.html --console",
		"dev:react": "bun src/react/index.html --console",
		"build": "rm -rf dist && NODE_ENV=production bun run build.ts",
		"build:dev": "rm -rf dist && NODE_ENV=development bun run build.ts",
		"serve": "bun dist/index.html",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"format": "bunx prettier --write .",
		"lint:style": "bunx stylelint \"**/*.{css,scss}\" --fix",
		"lint:html": "bunx markuplint \"**/*.{html}\" --fix",
		"lint": "bun run lint:style && bun run lint:html",
		"check": "bunx @biomejs/biome check .",
		"generate-sitemap": "bun run generate-sitemap.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@types/bun": "latest",
		"@types/node": "^25.9.4",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"bun-plugin-tailwind": "0.1.2",
		"fast-glob": "^3.3.3",
		"happy-dom": "^20.10.6",
		"markuplint": "^4.18.3",
		"prettier": "^3.8.4",
		"stylelint": "^16.26.1",
		"stylelint-config-prettier": "^9.0.5",
		"stylelint-config-standard": "39.0.1"
	},
	"peerDependencies": {
		"typescript": "^5.8.2"
	},
	"dependencies": {
		"@types/jquery": "^3.5.34",
		"jquery": "^4.0.0",
		"@radix-ui/react-checkbox": "^1.3.5",
		"@radix-ui/react-slot": "^1.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "0.577.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.1"
	}
}
